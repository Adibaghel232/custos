{
  "name": "custos-demo-console",
  "private": true,
  "version": "1.0.0",
  "description": "Custos demo console: Arena split screen, custody-graph Inspector and Bench dashboard (AEGIS 2026 finals).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "fixtures": "node scripts/gen-fixtures.ts && node scripts/check-fixtures.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.61.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
